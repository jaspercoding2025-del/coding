sortedlist1=[2,3,7]
sortedlist2=[1,4,6]
emptylist1=[]
emptylist2=[]
book1=[3,6,7,8]
book2=[1,3,4,6,8,9,9,9]
neglist1=[-3,-2,1,3,9]
neglist2=[-9,7,8,9]
def merge(sortedlist1,sortedlist2):
  finallist=[]
  tracker1=0
  tracker2=0
  while True:
    if len(sortedlist1)<=tracker1:
      for j in range(tracker2,len(sortedlist2),1):
        finallist.append(sortedlist2[j])
      break
    if len(sortedlist2)<=tracker2:
      for j in range(tracker1,len(sortedlist1),1):
        finallist.append(sortedlist1[j])
      break
    if sortedlist1[tracker1]> sortedlist2[tracker2]:
      finallist.append(sortedlist2[tracker2])
      tracker2+=1
    else:
      finallist.append(sortedlist1[tracker1])
      tracker1+=1
  return finallist 
    
print(merge(sortedlist1,sortedlist2))
print(merge(emptylist1,emptylist2))
print(merge(book1,book2))
print(merge(neglist1,neglist2))
